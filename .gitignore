bundletool.jar
*.apks

# Ambiente virtual Python
.venv/
venv/

# Cache Python
__pycache__/
*.pyc

# Banco de dados local gerado em tempo de execucao
*.db

# Editor / SO
.vscode/
.idea/
*.swp
.DS_Store

# Variaveis de ambiente do release.sh reunidas num arquivo local (senha e
