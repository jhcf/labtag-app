.env
app.env
secrets.json

# Chave de assinatura do APK de release e arquivos de senha associados —
# nunca commitar. Sem o .keystore original, nao da para publicar
# atualizacoes compativeis com quem ja instalou o app.
*.keystore
*.jks
key.properties

